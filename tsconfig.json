{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "outDir": "dist"
  },
  "include": ["playwright.config.ts", "config/**/*.ts", "pages/**/*.ts", "fixtures/**/*.ts", "api/**/*.ts", "utils/**/*.ts", "constants/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
